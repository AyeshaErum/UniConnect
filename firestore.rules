rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Users ──────────────────────────────────────────────────
    // Any authenticated user can read profiles (needed for tutor discovery)
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Help Posts ─────────────────────────────────────────────
    match /helpPosts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read:   if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth() && resource.data.authorId == request.auth.uid;
      }
    }

    // ── Masterclasses ──────────────────────────────────────────
    match /masterclasses/{classId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // ── Messages ───────────────────────────────────────────────
    match /messages/{conversationId} {
      allow read, write: if isAuth() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.participants;

      match /msgs/{msgId} {
        allow read, write: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants;
      }
    }

    // ── Notifications ──────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isOwner(userId);
    }

    // ── Success Stories ────────────────────────────────────────
    match /successStories/{storyId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }

    // ── Leaderboard (read-only derived from helpPosts + users) ─
    match /helpPosts/{postId} {
      allow read: if isAuth();
    }
  }
}
