rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the requester the owner of this document?
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Users ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Help Posts ─────────────────────────────────────────────
    match /helpPosts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth(); // upvotes, resolve — anyone auth'd
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read:   if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth() && resource.data.authorId == request.auth.uid;
      }
    }

    // ── Events ─────────────────────────────────────────────────
    match /events/{eventId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth(); // RSVP, edit
      allow delete: if isAuth() && resource.data.creatorId == request.auth.uid;
    }

    // ── Mentorship Slots ───────────────────────────────────────
    match /mentorshipSlots/{slotId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth() && resource.data.mentorId == request.auth.uid;
    }

    // ── Messages ───────────────────────────────────────────────
    match /messages/{conversationId} {
      // Only conversation participants can read/write
      allow read, write: if isAuth() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.participants;

      match /msgs/{msgId} {
        allow read, write: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants;
      }
    }

    // ── Notifications ──────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isOwner(userId);
    }

    // ── Success Stories ────────────────────────────────────────
    match /successStories/{storyId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth(); // likes
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }
  }
}
